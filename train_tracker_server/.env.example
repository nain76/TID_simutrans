# Train Tracker Server - Environment Variables Configuration
#
# このファイルを .env にコピーして、環境に合わせて編集してください
# Copy this file to .env and edit according to your environment
#
# Linux:   cp .env.example .env
# Windows: copy .env.example .env

# ============================================================
# Basic Authentication (必須 / Required)
# ============================================================

# ユーザー名 (Username for web access)
AUTH_USERNAME=admin

# パスワード (Password for web access)
# 本番環境では強力なパスワードに変更してください
# Change this to a strong password in production
AUTH_PASSWORD=changeme


# ============================================================
# Data File Path (必須 / Required)
# ============================================================

# Simutransが出力するJSONファイルのパス
# Path to JSON file exported by Simutrans

# Linux example:
# JSON_PATH=/home/username/simutrans/train_positions.json

# Windows example:
# JSON_PATH=C:\Users\username\simutrans\train_positions.json

# Current directory (default):
JSON_PATH=./train_positions.json


# ============================================================
# Server Configuration (オプション / Optional)
# ============================================================

# サーバーのポート番号 (Server port)
PORT=5000

# ホストアドレス (Host address)
# 0.0.0.0 = 外部からアクセス可能 (allow external access)
# 127.0.0.1 = ローカルのみ (localhost only)
HOST=0.0.0.0

# デバッグモード (Debug mode)
# 本番環境では false にしてください (set to false in production)
DEBUG=false


# ============================================================
# Advanced Settings (高度な設定 / Advanced)
# ============================================================

# Flask secret key (for session management)
# ランダムな文字列を生成してください (generate a random string)
# SECRET_KEY=your-random-secret-key-here

# Client-side update interval in milliseconds
# クライアント側の更新間隔（ミリ秒）
# UPDATE_INTERVAL_MS=5000
